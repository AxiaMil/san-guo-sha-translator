{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/match.py": {
      "maxDuration": 60,
      "includeFiles": "recognition/**",
      "excludeFiles": "{assets/**,site/**,node_modules/**,dist/**,tools/**,docs/**,scripts/**,lib/**,.venv/**,.venv312/**,.vercel_python_packages/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ]
}
